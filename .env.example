# Copia este archivo como .env y completa los valores. El .env NUNCA se sube a git.

# --- RabbitMQ (clúster de 2 nodos) ---
RABBIT_USER=wepay
RABBIT_PASS=<clave>
RABBIT_COOKIE=<texto largo aleatorio, igual en ambos nodos>
# Todo en una máquina: rabbitmq:5672,rabbitmq2:5672
# En AWS (Rabbit en otra EC2): <IP privada ec2-rabbitmq>:5672,<IP privada ec2-rabbitmq>:5673
RABBIT_ADDRESSES=rabbitmq:5672,rabbitmq2:5672

# --- Oracle en Amazon RDS (un usuario/esquema por microservicio) ---
ORACLE_URL=jdbc:oracle:thin:@//<endpoint-rds>:1521/WEPAY
CLIENTES_DB_USER=clientes
CLIENTES_DB_PASSWORD=<clave>
PEDIDOS_DB_USER=pedidos
PEDIDOS_DB_PASSWORD=<clave>
AUDITORIA_DB_USER=auditoria
AUDITORIA_DB_PASSWORD=<clave>
REPORTES_DB_USER=reportes
REPORTES_DB_PASSWORD=<clave>

# --- Entra ID (BFF) ---
ENTRA_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0
ENTRA_API_CLIENT_ID=<CLIENT_ID_DE_LA_API>
# Object ID del usuario que será ADMIN en ms-clientes
APP_ADMIN_OID=<OBJECT_ID>

# --- Kafka UI ---
KAFKA_UI_PASSWORD=<clave>
# 8080 en local; en AWS usamos 80 para que no lo bloqueen redes que filtran puertos
KAFKA_UI_PORT=8080

# --- Pruebas ---
# true = ms-notificaciones simula que facturación está caída (para ver la DLQ)
APP_FALLA_FACTURACION=false
