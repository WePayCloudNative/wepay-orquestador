# Copia este archivo como .env y completa los valores (.env no se sube a git)

# RabbitMQ (no uses guest: en AWS no funciona fuera de localhost)
RABBIT_USER=wepay
RABBIT_PASS=cambia_esta_clave

# Entra ID - BFF
ENTRA_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0
ENTRA_API_CLIENT_ID=<CLIENT_ID_DE_LA_API>

# Entra ID - Front
VITE_ENTRA_TENANT_ID=<TENANT_ID>
VITE_SPA_CLIENT_ID=<CLIENT_ID_DE_LA_SPA>
VITE_API_CLIENT_ID=<CLIENT_ID_DE_LA_API>

# OID (Object ID en Entra) del usuario que sera ADMIN en ms-clientes
APP_ADMIN_OID=<TU_OBJECT_ID>
